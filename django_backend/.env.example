# ==============================================================================
# Wisdom Pharma Django Backend - Environment Configuration
# ==============================================================================

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# MongoDB DSN (Optional for MongoDB Unit VI integration)
MONGODB_DSN=
DB_NAME=wisdom_pharma

# SMTP Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Google Gemini AI API Key (for Chatbot & Symptom Advice)
GEMINI_API_KEY=your-gemini-api-key-here

# Default Admin Credentials (used by initial seeding)
ADMIN_EMAIL=wisdom.admin@wisdompharma.com
ADMIN_PASSWORD=WisdomAdmin@123

# Frontend Application Origin (for CORS)
FRONTEND_URL=https://your-frontend-deployment.vercel.app
